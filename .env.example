# Copy to .env (make and docker compose read it). Everything is optional in local mode.
# See Documents/configuration.md for the full list.

CC_MODE=local                 # local | azure

# --- Swap in real Azure services one at a time (the rest stay mocked) -----------------
# SPEECH_BACKEND=azure
# SPEECH_ENDPOINT=https://<speech-resource>.cognitiveservices.azure.com
# SPEECH_KEY=<key>            # omit to use your az login / managed identity

# LANGUAGE_BACKEND=azure
# LANGUAGE_ENDPOINT=https://<language-resource>.cognitiveservices.azure.com
# LANGUAGE_KEY=<key>

# LLM_BACKEND=azure
# AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com
# AZURE_OPENAI_KEY=<key>
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# STORAGE_BACKEND=azure
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true   # Azurite

# STORE_BACKEND=cosmos
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_KEY=<key>

# --- Web app ---------------------------------------------------------------------------
# AUTH_MODE=dev               # dev (demo users) | entra
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# CRM_API_KEYS=local-test-key
