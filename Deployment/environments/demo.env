# Deployment variables for the DEMO environment, read by:  Deployment/scripts/deploy.sh -e demo
# Command-line options override these values. Service sizes (SKUs) are in
# Deployment/ARM/parameters/demo.parameters.json. Do not put secrets in this file.

# Subscription ID or name. Empty = the subscription currently selected in `az account show`.
AZURE_SUBSCRIPTION=""

# Resource group for the demo (created if it does not exist). Delete it to remove the whole demo.
RESOURCE_GROUP="Vaibhav.Chaudhary"

# Region for the resource group and all services (Azure OpenAI region is openAiLocation in the parameters file).
LOCATION="centralindia"

# 1 = create/update the Entra ID app registration, roles and client secret with setup_entra.sh (needs Microsoft
#     Graph access). 0 here because the demo is deployed from Cloud Shell, where Graph tokens are refused:
#     the app is registered in the portal and its client ID/secret passed with --param (deployment guide).
SETUP_ENTRA=0

# 1 = upload the 4 demo recordings (Data/demo_calls) after deployment, for the test checklist in
#     Data/demo_calls/README.md. Needs `make setup` on this machine first (not with CODE_VIA_ARM=1).
SEED=1

# 1 = deploy code and demo calls with management-API calls only (Deployment/scripts/deploy_code_arm.sh):
#     packages include all Python libraries, uploaded with the storage account key. Use it where tokens for
#     App Service, Storage or Graph cannot be obtained (Azure Cloud Shell under Conditional Access).
CODE_VIA_ARM=1
