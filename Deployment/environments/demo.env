# Deployment variables for the DEMO environment, read by:  Deployment/scripts/deploy.sh -e demo
# Command-line options override these values. Service sizes (SKUs) are in
# Deployment/ARM/parameters/demo.parameters.json. Do not put secrets in this file.

# Subscription ID or name. Empty = the subscription currently selected in `az account show`.
AZURE_SUBSCRIPTION=""

# Resource group for the demo (created if it does not exist). Delete it to remove the whole demo.
RESOURCE_GROUP="Vaibhav.Chaudhary"

# Region for the resource group and all services (Azure OpenAI region is openAiLocation in the parameters file).
LOCATION="centralindia"

# 1 = create/update the Entra ID app registration, roles and client secret. Needed on the FIRST deployment;
#     set it to 0 afterwards (each run adds a new client secret), or pass --no-setup-entra.
SETUP_ENTRA=1

# 1 = upload the 4 demo recordings (Data/demo_calls) after deployment, for the test checklist in
#     Data/demo_calls/README.md. Needs `make setup` on this machine first.
SEED=1
